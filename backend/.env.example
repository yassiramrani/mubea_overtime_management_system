# Local development example. Preserve existing .env files and never commit secrets.
# Generate your own local secret; this placeholder is not suitable for deployment.
SECRET_KEY=django-insecure-local-development-replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite for local development. Run Django commands from backend/.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# PostgreSQL connection example: create the database/account separately.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=overtime_db
# DB_USER=overtime_app
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Local delivery prints mail when manage.py send_notifications runs.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=overtime@example.invalid

# For real SMTP, set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and supply the company's host, sender, and credentials privately.
# EMAIL_HOST=smtp.example.invalid
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

PUBLIC_BASE_URL=http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shared login throttling in production; unused by DEBUG=True development.
# Notifications use a scheduled management command, not Celery.
REDIS_URL=
AUTH_TOKEN_TTL_SECONDS=28800

# Set only behind a trusted HTTPS proxy that overwrites forwarding headers.
TRUST_PROXY_SSL_HEADER=False
CSRF_TRUSTED_ORIGINS=

# Deployment requires a separate secret environment with DEBUG=False and
# DJANGO_SETTINGS_MODULE=core.production_settings set in the process environment.
# See docs/PRODUCTION_READINESS.md for all remaining launch requirements.
