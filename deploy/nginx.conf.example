# Replace the domain, certificate paths and root before installation.
server {
    listen 80;
    server_name overtime.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name overtime.example.com;
    ssl_certificate /etc/letsencrypt/live/overtime.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/overtime.example.com/privkey.pem;
    root /opt/overtime/frontend/dist;
    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;

    location / { try_files $uri $uri/ /index.html; }
    location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }
    location /static/ { alias /opt/overtime/backend/staticfiles/; }
    # Saved exports are served through authenticated API actions, never a media alias.
    location ~ ^/(api|admin|health)/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 65s;
    }
}
