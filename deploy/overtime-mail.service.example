[Unit]
Description=Deliver queued overtime notifications
# Production defaults to disabled delivery. Verify sender receipt, then explicitly
# set NOTIFICATIONS_DELIVERY_ENABLED=True in the dedicated environment file.
[Service]
Type=oneshot
User=overtime
Group=overtime
WorkingDirectory=/opt/overtime/backend
EnvironmentFile=/etc/overtime/production.env
Environment=DJANGO_SETTINGS_MODULE=core.production_settings
ExecStart=/opt/overtime/backend/venv/bin/python manage.py send_notifications --limit 100
NoNewPrivileges=true
PrivateTmp=true
