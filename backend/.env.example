# Local development example. Preserve existing .env files and never commit secrets.
# Generate your own local secret; this placeholder is not suitable for deployment.
SECRET_KEY=django-insecure-local-development-replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite for local development. Run Django commands from backend/.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# PostgreSQL connection example: create the database/account separately.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=overtime_db
# DB_USER=overtime_app
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Local delivery prints mail when manage.py send_notifications runs.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=overtime@example.invalid

# Real SMTP delivery. Switch the backend, then supply the company relay, sender, and
# credentials privately; never commit them. Microsoft 365 example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=<sender mailbox>
# EMAIL_HOST_PASSWORD=<mailbox or app password>
# DEFAULT_FROM_EMAIL=<sender mailbox>
# Use EMAIL_PORT=465 with EMAIL_USE_TLS=False and EMAIL_USE_SSL=True when a relay
# requires implicit TLS. A stuck SMTP conversation is abandoned after this many
# seconds so the delivery command cannot hang.
EMAIL_TIMEOUT=20

# Verify the settings before relying on them:
#   python manage.py send_test_email --to <your-address>

# Alternative sender for a Windows machine that already runs signed-in Outlook: hand
# the message to Outlook instead of authenticating to SMTP. No mailbox password is
# used, so it needs nothing from IT. Outlook must be running and signed in, Outlook's
# programmatic-access policy applies, and the Linux deployment cannot use it.
# EMAIL_BACKEND=overtimeapp.email_backends.OutlookComEmailBackend

# Optional passwords for the one-off `manage.py seed_users` account provisioning.
# Prefer passing these in the process environment; never reuse a real password in source.
# SEED_PASSWORD=
# SEED_PASSWORD_YASSIR_AMRANI=

PUBLIC_BASE_URL=http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shared login throttling in production; unused by DEBUG=True development.
# Notifications use a scheduled management command, not Celery.
REDIS_URL=
AUTH_TOKEN_TTL_SECONDS=28800

# Set only behind a trusted HTTPS proxy that overwrites forwarding headers.
TRUST_PROXY_SSL_HEADER=False
CSRF_TRUSTED_ORIGINS=

# Deployment requires a separate secret environment with DEBUG=False and
# DJANGO_SETTINGS_MODULE=core.production_settings set in the process environment.
# See docs/PRODUCTION_READINESS.md for all remaining launch requirements.
